<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>marvin_mujoco_bridge</name>
  <version>0.1.0</version>
  <description>Bridge MoveIt2 JointTrajectory commands to a MuJoCo ZMQ REQ/REP service.</description>
  <maintainer email="yang@todo.todo">yang</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>control_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>trajectory_msgs</depend>

  <exec_depend>python3-zmq</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
